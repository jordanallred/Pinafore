    "theme_version": "0.1.0",
    "theme_author": "Little Monkey Toes",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://shopify.dev/docs/storefronts/themes"
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "header",
            "content": "t:general.surface"
          },
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#FAF8F5"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:labels.background_gradient"
          },
          {
            "type": "header",
            "content": "t:general.text"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:labels.text",
            "default": "#2E2A26"
          },
          {
            "type": "color",
            "id": "text_muted",
            "label": "t:labels.text_muted",
            "info": "t:info.text_muted",
            "default": "#6B6259"
          },
          {
            "type": "header",
            "content": "t:general.buttons"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:labels.button_background",
            "default": "#2E2A26"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:labels.button_label",
            "default": "#FAF8F5"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:labels.secondary_button_label",
            "default": "#2E2A26"
          },
          {
            "type": "header",
            "content": "t:general.accent"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:labels.accent_background",
            "info": "t:info.accent",
            "default": "#35506E"
          },
          {
            "type": "color",
            "id": "accent_label",
            "label": "t:labels.accent_label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "sale",
            "label": "t:labels.sale",
            "info": "t:info.sale",
            "default": "#8F3A2E"
          },
          {
            "type": "header",
            "content": "t:general.lines"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:labels.border",
            "info": "t:info.border",
            "default": "#DDD5CB"
          },
          {
            "type": "color",
            "id": "border_control",
            "label": "t:labels.border_control",
            "info": "t:info.border_control",
            "default": "#8A8076"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "t:labels.shadow",
            "default": "#2E2A26"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "text",
          "links": "text",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "border_control"
        }
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:labels.heading_font",
        "default": "eb_garamond_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:labels.body_font",
        "default": "karla_n4"
      },
      {
        "type": "header",
        "content": "t:general.scale"
      },
      {
        "type": "range",
        "id": "type_body_size",
        "label": "t:labels.body_size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "label": "t:labels.heading_scale",
        "info": "t:info.heading_scale",
        "min": 100,
        "max": 140,
        "step": 5,
        "unit": "%",
        "default": 115
      },
      {
        "type": "select",
        "id": "type_heading_case",
        "label": "t:labels.heading_case",
        "options": [
          {
            "value": "none",
            "label": "t:options.case.none"
          },
          {
            "value": "uppercase",
            "label": "t:options.case.uppercase"
          }
        ],
        "default": "none"
      },
      {
        "type": "range",
        "id": "type_heading_letter_spacing",
        "label": "t:labels.heading_letter_spacing",
        "min": -3,
        "max": 10,
        "step": 1,
        "unit": "t:units.hundredth_em",
        "default": -1
      },
      {
        "type": "header",
        "content": "t:general.accents"
      },
      {
        "type": "select",
        "id": "type_eyebrow_font",
        "label": "t:labels.eyebrow_font",
        "info": "t:info.eyebrow_font",
        "options": [
          {
            "value": "body",
            "label": "t:options.font_role.body"
          },
          {
            "value": "heading",
            "label": "t:options.font_role.heading"
          }
        ],
        "default": "body"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "80rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.medium"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "label": "t:labels.page_margin",
        "min": 12,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "select",
        "id": "layout_density",
        "label": "t:labels.density",
        "info": "t:info.density",
        "options": [
          {
            "value": "compact",
            "label": "t:options.density.compact"
          },
          {
            "value": "default",
            "label": "t:options.density.default"
          },
          {
            "value": "spacious",
            "label": "t:options.density.spacious"
          }
        ],
        "default": "spacious"
      }
    ]
  },
