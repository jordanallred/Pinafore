{% comment %}
  Collection listing with faceted filtering.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{% paginate collection.products by section.settings.per_page %}
  <div class="collection color-{{ section.settings.color_scheme }}" data-results>
    <header class="collection__header">
      <h1 class="collection__title">{{ collection.title }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="collection__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.show_filters -%}
      {% render 'facets', results: collection, section: section %}
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      {% render 'product-grid', products: collection.products, columns: section.settings.columns %}

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- else -%}
      <div class="collection__empty">
        <p>{{ 'collections.empty' | t }}</p>
        <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">
          {{ 'collections.browse_all' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
{% endpaginate %}

{% stylesheet %}
  .collection {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block: var(--space-lg);
  }

  .collection__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .collection__title {
    margin: 0;
  }

  .collection__description {
    max-width: 60ch;
    color: var(--color-foreground-muted);
  }

  .collection__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-block: var(--space-xl);
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:labels.show_description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:labels.show_filters",
      "info": "t:info.show_filters",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:labels.per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme_1"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
