{% comment %}
  Hero banner.

  Sized in svh rather than vh so mobile browser chrome collapsing does not
  jump the layout, and the image is never lazy-loaded — this is the LCP
  element on the homepage and deferring it is the fastest way to fail the
  Theme Store's performance floor.
{% endcomment %}

{% liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif

  assign heading_alt = section.settings.image.alt | default: section.settings.heading | escape
%}

{%- comment -%}
  With no image the hero becomes a typographic panel rather than a shorter
  photograph. Holding 70svh of empty colour and pinning the copy to one corner
  is what an unconfigured section looks like, not what a deliberate one looks
  like — and a merchant who has product photography but no lifestyle shot
  should still get a homepage that reads as finished.
{%- endcomment -%}
<div
  class="hero color-{{ section.settings.color_scheme }} full-width{% unless has_image %} hero--textual{% endunless %}"
  style="--hero-height: {{ section.settings.height }}svh; --overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {%- if has_image -%}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          alt: heading_alt,
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero__image'
      }}
      {%- if section.settings.image_mobile != blank -%}
        {{
          section.settings.image_mobile
          | image_url: width: 1200
          | image_tag:
            widths: '400, 600, 900, 1200',
            sizes: '100vw',
            alt: heading_alt,
            loading: 'eager',
            fetchpriority: 'high',
            class: 'hero__image hero__image--mobile'
        }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hero__content hero__content--{{ section.settings.alignment }}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="hero__heading text-display">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hero__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="button hero__button" href="{{ section.settings.button_url | default: '#' }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /*
   * The hero is full-bleed, so it re-establishes the page grid for its own
   * content. Without this the copy sat hard against the viewport edge while
   * the header logo sat at the content column — a visible misalignment on
   * every page load.
   */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: var(--content-grid);
    min-height: var(--hero-height, 70svh);
    isolation: isolate;
  }

  /*
   * No photograph: size to the words instead of to the viewport, centre them,
   * and let the type carry the section. The seam along the bottom edge ties it
   * to the rest of the page so the band reads as a masthead rather than as an
   * image that failed to load.
   */
  .hero--textual {
    min-height: 0;
    padding-block: clamp(var(--space-lg), 10vw, var(--space-2xl));
  }

  .hero--textual .hero__content {
    align-items: center;
    text-align: center;
    max-width: 46rem;
    margin-inline: auto;
    padding-block: 0;
  }

  /*
   * The button sets its own `align-self: flex-start` so it never stretches to
   * the content width. That beats the container's `align-items`, so centring
   * has to be said on the button itself.
   */
  .hero--textual .hero__button {
    align-self: center;
  }

  .hero--textual .hero__heading {
    /* Slightly tighter than the photographic hero: nothing behind it to
       compete with, so the measure matters more than the scale. */
    font-size: clamp(var(--text-3xl), 7vw, var(--text-5xl, 4.5rem));
  }

  .hero--textual .hero__text {
    max-width: 34rem;
  }

  .hero__media {
    grid-column: 1 / -1;
    grid-row: 1;
    position: relative;
    z-index: -1;
  }

  .hero__media::before {
    /* Holds the media cell open when there is no image yet. */
    content: '';
    display: block;
    min-height: var(--hero-height, 70svh);
  }

  /*
   * A scrim rather than a flat overlay: it is strongest behind the text and
   * fades out across the image, so the photograph stays legible while the
   * copy still clears 4.5:1. A uniform wash would have to be much heavier to
   * pass, and would grey out the product.
   */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / var(--overlay, 0.35)) 0%,
      rgb(0 0 0 / calc(var(--overlay, 0.35) * 0.5)) 45%,
      transparent 100%
    );
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__image--mobile {
    display: none;
  }

  .hero__content {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-self: end;
    padding-block: var(--space-lg);
    max-width: 42rem;
  }

  .hero__content--center {
    align-self: center;
    justify-self: center;
    text-align: center;
    align-items: center;
  }

  .hero__content--end {
    justify-self: end;
    text-align: right;
    align-items: flex-end;
  }

  .hero__heading {
    margin: 0;
  }

  .hero__button {
    margin-top: var(--space-2xs);
    align-self: flex-start;
  }

  .hero__content--center .hero__button {
    align-self: center;
  }

  .hero__content--end .hero__button {
    align-self: flex-end;
  }

  @media screen and (max-width: 749px) {
    .hero:has(.hero__image--mobile) .hero__image:not(.hero__image--mobile) {
      display: none;
    }

    .hero__image--mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.image_mobile",
      "info": "t:info.image_mobile"
    },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Fall preorder" },
    { "type": "richtext", "id": "text", "label": "t:labels.text" },
    { "type": "text", "id": "button_label", "label": "t:labels.link_label", "default": "Shop the drop" },
    { "type": "url", "id": "button_url", "label": "t:labels.link_url" },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "start", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "end", "label": "t:options.alignment.right" }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:labels.height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay",
      "info": "t:info.overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme_2"
    }
  ],
  "presets": [{ "name": "t:general.hero" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
