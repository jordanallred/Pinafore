{% comment %}
  The collection directory.

  For a single-label shop this page is an afterthought. For a boutique it is a
  primary way in: a parent arrives knowing "Properly Tied" or "Back to School"
  and wants the whole roster in one view, not a search box.

  So it is built as a directory rather than a wall of tiles — an optional
  alphabet rail that jumps down the page, and grouping by initial. With sixty
  entries a plain grid means scrolling and hoping; an index means finding.

  `{% paginate %}` is not optional here. A bare `for` over `collections` stops
  at 50 and would silently drop the tail of the roster while looking perfectly
  correct on a small store.
{% endcomment %}

{%- liquid
  # Resolved separately rather than as `heading | default: key | t`: that
  # chain runs the translation filter over the merchant's own heading when
  # they have set one, which yields "translation missing".
  assign directory_title = section.settings.heading
  if directory_title == blank
    assign directory_title = 'collections.title' | t
  endif
-%}

{% paginate collections by section.settings.per_page %}
  <div class="directory-band band color-{{ section.settings.color_scheme }} full-width section-spacing">
    <div class="directory band__inner">
      <header class="directory__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="directory__title">{{ directory_title }}</h1>
        {%- if section.settings.description != blank -%}
          <div class="directory__intro rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </header>

      {%- if collections.size > 0 -%}
        {%- comment -%}
          The rail lists only the initials that actually have entries, so it
          never offers a jump to an empty letter.
        {%- endcomment -%}
        {%- if section.settings.show_index -%}
          {%- assign initials = '' -%}
          {%- for collection in collections -%}
            {%- assign letter = collection.title | slice: 0 | upcase -%}
            {%- unless initials contains letter -%}
              {%- assign initials = initials | append: letter -%}
            {%- endunless -%}
          {%- endfor -%}

          <nav class="directory__index" aria-label="{{ 'collections.jump_to' | t }}">
            <ul class="directory__letters" role="list">
              {%- assign letter_list = initials | split: '' | sort -%}
              {%- for letter in letter_list -%}
                <li>
                  <a class="directory__letter" href="#directory-{{ letter }}">{{ letter }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- assign current_letter = '' -%}
        <ul class="directory__grid" style="--directory-columns: {{ section.settings.columns }};" role="list">
          {%- for collection in collections -%}
            {%- assign letter = collection.title | slice: 0 | upcase -%}
            {%- if section.settings.show_index and letter != current_letter -%}
              {%- assign current_letter = letter -%}
              <li class="directory__divider" id="directory-{{ letter }}">
                <span class="directory__divider-letter">{{ letter }}</span>
                <span class="seam directory__divider-rule"></span>
              </li>
            {%- endif -%}

            <li class="directory-card">
              <a class="directory-card__link" href="{{ collection.url }}">
                <span class="directory-card__media media media--ratio">
                  {%- if collection.featured_image -%}
                    {{
                      collection.featured_image
                      | image_url: width: 600
                      | image_tag:
                        widths: '200, 300, 450, 600',
                        sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 45vw',
                        alt: '',
                        loading: 'lazy',
                        class: 'directory-card__image'
                    }}
                  {%- endif -%}
                </span>
                <span class="directory-card__title">{{ collection.title }}</span>
                {%- if section.settings.show_count -%}
                  <span class="directory-card__count">
                    {{ 'collections.product_count' | t: count: collection.all_products_count }}
                  </span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- else -%}
        <p class="directory__empty">{{ 'collections.empty' | t }}</p>
      {%- endif -%}
    </div>
  </div>
{% endpaginate %}

{% stylesheet %}
  .directory {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .directory__header {
    display: grid;
    gap: var(--space-3xs);
  }

  .directory__title {
    margin: 0;
  }

  .directory__intro {
    max-width: 44rem;
    color: var(--color-foreground-muted);
  }

  /*
   * Sticky so the alphabet stays reachable while scrolling a long roster —
   * the one place on this page where a fixed element earns its keep.
   */
  .directory__index {
    position: sticky;
    top: 0;
    z-index: 1;
    padding-block: var(--space-2xs);
    background-color: var(--color-background);
  }

  .directory__letters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .directory__letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .directory__letter:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .directory__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-sm);
  }

  @media screen and (min-width: 750px) {
    .directory__grid {
      grid-template-columns: repeat(var(--directory-columns, 4), minmax(0, 1fr));
    }
  }

  /* The letter heading spans the row so grouping is visible, not implied. */
  .directory__divider {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-xs);
    scroll-margin-top: 4rem;
  }

  .directory__divider:first-child {
    margin-block-start: 0;
  }

  .directory__divider-letter {
    font-family: var(--font-heading--family);
    font-size: var(--text-lg);
    line-height: 1;
  }

  .directory__divider-rule {
    flex: 1;
  }

  .directory-card__link {
    display: grid;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .directory-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .directory-card__title {
    font-family: var(--font-heading--family);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .directory-card__count {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .directory__empty {
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "richtext", "id": "description", "label": "t:labels.text" },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "t:labels.show_index",
      "info": "t:info.show_index",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:labels.show_count",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:labels.per_page",
      "min": 12,
      "max": 48,
      "step": 12,
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme_1"
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
