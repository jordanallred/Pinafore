{% comment %}
  Product recommendations.

  The product template shipped with exactly one section, so every product page
  ended at the accordions — a customer arriving from search had nowhere to go
  but back. For a shop carrying eighteen labels that is also the cheapest place
  to show a second brand.

  Shopify's recommendations are only populated on a request to the
  recommendations endpoint, so the section renders empty on first paint and
  <pinafore-recommendations> fetches the real thing and swaps it in. That keeps
  the product page's own response fast and means no recommendation work happens
  for a customer who never scrolls this far.

  https://shopify.dev/docs/storefronts/themes/product-merchandising/recommendations
{% endcomment %}

{%- comment -%}
  Built with separate assigns rather than one filter chain: inside a
  `{% liquid %}` block a newline ends the statement, so a chain wrapped across
  lines is parsed as several broken statements.
{%- endcomment -%}
{% liquid
  assign limit = section.settings.products_to_show
  assign url = routes.product_recommendations_url | append: '?section_id=' | append: section.id
  assign url = url | append: '&product_id=' | append: product.id
  assign url = url | append: '&limit=' | append: limit
  assign url = url | append: '&intent=' | append: section.settings.intent
%}

<pinafore-recommendations
  class="recs band color-{{ section.settings.color_scheme }} full-width section-spacing"
  data-url="{{ url }}"
  data-intent="{{ section.settings.intent }}"
>
  {%- if recommendations.performed -%}
    {%- if recommendations.products_count > 0 -%}
      <div class="band__inner">
        <div class="recs__head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="recs__heading">{{ section.settings.heading }}</h2>
        </div>

        <div class="recs__grid" style="--grid-columns: {{ section.settings.columns }};">
          {%- for recommendation in recommendations.products -%}
            {% render 'product-card',
              product: recommendation,
              sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 50vw'
            %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</pinafore-recommendations>

{% stylesheet %}
  .recs__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block-end: var(--space-md);
  }

  .recs__heading {
    font-size: var(--text-xl);
    margin: 0;
  }

  .recs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-sm);
  }

  @media screen and (min-width: 750px) {
    .recs__grid {
      grid-template-columns: repeat(var(--grid-columns, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.recommendations",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Keep looking"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You might also like"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:labels.intent",
      "info": "t:info.intent",
      "options": [
        { "value": "related", "label": "t:options.intent.related" },
        { "value": "complementary", "label": "t:options.intent.complementary" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_shown",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme_1"
    }
  ],
  "presets": [{ "name": "t:general.recommendations" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
