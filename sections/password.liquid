{% comment %}
  The password landing page.

  This is what a boutique shows for the days between building the store and
  opening it, and again before a seasonal drop. It is the only page some
  customers will see, so it collects an email rather than just refusing entry.

  The newsletter form comes first and the password entry is tucked into a
  disclosure below it: almost everyone arriving here is a customer, not the
  owner, and the owner knows where the box is.
{% endcomment %}

<div class="password-band band color-{{ section.settings.color_scheme }} full-width">
  <div class="password band__inner">
    <header class="password__header">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_alt = shop.name | escape -%}
        <span class="password__logo" style="--logo-width: {{ section.settings.logo_width }}px;">
          {{
            section.settings.logo
            | image_url: width: 600
            | image_tag: widths: '150, 300, 450, 600', alt: logo_alt, loading: 'eager'
          }}
        </span>
      {%- else -%}
        <h1 class="password__shop">{{ shop.name }}</h1>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <p class="password__heading">{{ section.settings.heading }}</p>
      {%- endif -%}

      {%- if shop.password_message != blank -%}
        <div class="password__message rte">{{ shop.password_message }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', class: 'form password__newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,password-page">

        {%- if form.posted_successfully? -%}
          <p class="form__success" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form__errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          {%- assign label_email = 'newsletter.email' | t -%}
          {% render 'form-field',
            id: 'PasswordNewsletter',
            name: 'contact[email]',
            label: label_email,
            type: 'email',
            autocomplete: 'email',
            required: true
          %}
          <button type="submit" class="button button--full">
            {{ 'newsletter.submit' | t }}
          </button>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <hr class="seam password__rule">

    <details class="password__enter">
      <summary class="password__enter-summary">{{ 'password.owner_prompt' | t }}</summary>

      {%- form 'storefront_password', class: 'form' -%}
        {%- if form.errors -%}
          <div class="form__errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        {%- assign label_password = 'password.password' | t -%}
        {% render 'form-field',
          id: 'StorefrontPassword',
          name: 'password',
          label: label_password,
          type: 'password',
          autocomplete: 'current-password',
          required: true
        %}
        <button type="submit" class="button button--full">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>

    <p class="password__powered">
      {{ powered_by_link }}
    </p>
  </div>
</div>

{% stylesheet %}
  .password {
    /*
     * Centred in the viewport rather than the flow: this template has no
     * header or footer, so without it the card floats near the top of a tall
     * screen with nothing to anchor it.
     */
    min-height: 100svh;
    width: min(28rem, calc(100% - var(--page-margin) * 2));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
    padding-block: var(--space-lg);
  }

  .password__header {
    display: grid;
    gap: var(--space-2xs);
    justify-items: center;
    text-align: center;
  }

  .password__logo img {
    width: var(--logo-width, 180px);
    max-width: 100%;
    height: auto;
  }

  .password__shop {
    margin: 0;
    font-size: var(--text-2xl);
  }

  .password__heading {
    margin: 0;
    font-size: var(--text-lg);
    font-family: var(--font-heading--family);
  }

  .password__message {
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
  }

  .password__rule {
    width: 100%;
  }

  .password__enter-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-target);
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
    cursor: pointer;
  }

  .password__enter-summary::-webkit-details-marker {
    display: none;
  }

  .password__enter[open] .password__enter-summary {
    margin-block-end: var(--space-xs);
  }

  .password__powered {
    margin: 0;
    text-align: center;
    font-size: var(--text-2xs);
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "t:labels.logo" },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:labels.logo_width",
      "min": 80,
      "max": 320,
      "step": 20,
      "unit": "px",
      "default": 180
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Opening soon"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:labels.show_newsletter",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
