{% comment %}
  Activate an invited account.

  Shopify sends this link when a merchant invites a customer — common after a
  platform migration, which is exactly what this store is going through, so
  it declines as clearly as it accepts.
{% endcomment %}

{%- liquid
  assign label_password = 'customers.reset.password' | t
  assign label_confirm = 'customers.reset.confirm' | t
-%}

<div class="activate-band band color-{{ section.settings.color_scheme }} full-width">
  <div class="auth band__inner">
    <header class="auth__header">
      <h1 class="auth__title">{{ 'customers.activate.title' | t }}</h1>
      <p class="auth__note">{{ 'customers.activate.instructions' | t }}</p>
    </header>

    {%- form 'activate_customer_password', class: 'form' -%}
      {%- if form.errors -%}
        <div class="form__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      {% render 'form-field',
        id: 'ActivatePassword',
        name: 'customer[password]',
        label: label_password,
        type: 'password',
        autocomplete: 'new-password',
        required: true
      %}

      {% render 'form-field',
        id: 'ActivatePasswordConfirm',
        name: 'customer[password_confirmation]',
        label: label_confirm,
        type: 'password',
        autocomplete: 'new-password',
        required: true
      %}

      <div class="form__actions">
        <button type="submit" class="button">
          {{ 'customers.activate.submit' | t }}
        </button>
        <button type="submit" name="decline" class="button button--secondary">
          {{ 'customers.activate.decline' | t }}
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.activate_account",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
