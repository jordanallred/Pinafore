{% comment %}
  Seasonal collection tiles.

  How a boutique actually merchandises: Back to School, Collegiate,
  Fall/Winter, Halloween. Little Monkey Toes' own navigation is built around
  these, and they change several times a year.

  The collection name is real text laid over the photograph, never baked into
  the image. Competitors in this category ship JPEGs with the season set in
  script — which cannot be translated, cannot be read aloud, does not reflow
  on a phone, and leaves the shop owner needing Photoshop to change a word.
  Rendering it as text costs nothing and removes all four problems.
{% endcomment %}

<div class="tiles color-{{ section.settings.color_scheme }} section-spacing">
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <header class="tiles__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="tiles__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </header>
  {%- endif -%}

  <ul
    class="tiles__grid"
    style="--tile-columns: {{ section.settings.columns }}; --tile-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
    role="list"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_collection = block.settings.collection
        assign tile_title = block.settings.heading
        if tile_title == blank and tile_collection != blank
          assign tile_title = tile_collection.title
        endif

        assign tile_image = block.settings.image
        if tile_image == blank and tile_collection != blank
          assign tile_image = tile_collection.featured_image
        endif

        assign tile_url = block.settings.url
        if tile_url == blank and tile_collection != blank
          assign tile_url = tile_collection.url
        endif

        assign tile_alt = tile_title | escape
      -%}

      <li class="tile" {{ block.shopify_attributes }}>
        <a class="tile__link" href="{{ tile_url | default: '#' }}">
          <span class="tile__media">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 900
                | image_tag:
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 750px) 33vw, 70vw',
                  alt: tile_alt,
                  loading: 'lazy',
                  class: 'tile__image'
              }}
            {%- endif -%}
          </span>
          <span class="tile__label">
            <span class="tile__title">{{ tile_title }}</span>
            {%- if block.settings.caption != blank -%}
              <span class="tile__caption">{{ block.settings.caption }}</span>
            {%- endif -%}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .tiles {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .tiles__header {
    display: grid;
    gap: var(--space-3xs);
  }

  .tiles__heading {
    margin: 0;
  }

  .tiles__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Two up on a phone; a seasonal row is for scanning, not for reading. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  @media screen and (min-width: 750px) {
    .tiles__grid {
      grid-template-columns: repeat(var(--tile-columns, 3), minmax(0, 1fr));
    }
  }

  .tile__link {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-media);
    text-decoration: none;
    isolation: isolate;
  }

  .tile__media {
    display: block;
    aspect-ratio: var(--media-ratio, 3 / 4);
    background-color: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  @media (hover: hover) {
    .tile__link:hover .tile__image {
      transform: scale(1.04);
    }
  }

  /*
   * A bottom-anchored scrim rather than a full wash: the label stays legible
   * without greying out the garment, which is the thing being sold.
   */
  .tile__label {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: var(--space-md) var(--space-sm) var(--space-sm);
    color: #fff;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / var(--tile-overlay, 0.5)) 0%,
      rgb(0 0 0 / calc(var(--tile-overlay, 0.5) * 0.55)) 55%,
      transparent 100%
    );
  }

  .tile__title {
    font-family: var(--font-heading--family);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    /* Holds the name legible over a busy print without a heavier scrim. */
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.45);
  }

  .tile__caption {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    opacity: 0.9;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.45);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_tiles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Shop the season" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "New collections" },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:labels.overlay",
      "info": "t:info.overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 50
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme_1"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:general.collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:labels.collection" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:info.tile_image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "info": "t:info.tile_heading"
        },
        { "type": "text", "id": "caption", "label": "t:labels.caption" },
        { "type": "url", "id": "url", "label": "t:labels.link_url" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
