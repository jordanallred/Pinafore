{% comment %}
  Create an account.

  Name fields are optional on purpose. Shopify does not require them, and a
  boutique gains more from a completed signup than from a first name it can
  collect at checkout anyway.
{% endcomment %}

{%- liquid
  assign label_first = 'customers.register.first_name' | t
  assign label_last = 'customers.register.last_name' | t
  assign label_email = 'customers.login.email' | t
  assign label_password = 'customers.login.password' | t
-%}

<div class="register-band band color-{{ section.settings.color_scheme }} full-width">
  <div class="auth band__inner">
    <header class="auth__header">
      <h1 class="auth__title">{{ 'customers.register.title' | t }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="auth__note rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- form 'create_customer', class: 'form' -%}
      {%- if form.errors -%}
        <div class="form__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="form__row form__row--split">
        {% render 'form-field',
          id: 'RegisterFirstName',
          name: 'customer[first_name]',
          label: label_first,
          autocomplete: 'given-name'
        %}
        {% render 'form-field',
          id: 'RegisterLastName',
          name: 'customer[last_name]',
          label: label_last,
          autocomplete: 'family-name'
        %}
      </div>

      {% render 'form-field',
        id: 'RegisterEmail',
        name: 'customer[email]',
        label: label_email,
        type: 'email',
        autocomplete: 'email',
        required: true
      %}

      {% render 'form-field',
        id: 'RegisterPassword',
        name: 'customer[password]',
        label: label_password,
        type: 'password',
        autocomplete: 'new-password',
        required: true
      %}

      {%- if section.settings.show_marketing_optin -%}
        {%- comment -%}
          Unchecked by default and worded as an opt-in. A pre-ticked marketing
          box is not consent, and several jurisdictions treat it as invalid.
        {%- endcomment -%}
        <div class="auth__optin">
          <input
            type="checkbox"
            id="RegisterMarketing"
            name="customer[accepts_marketing]"
            value="true"
          >
          <label for="RegisterMarketing">{{ 'customers.register.marketing' | t }}</label>
        </div>
      {%- endif -%}

      <button type="submit" class="button button--full">
        {{ 'customers.register.submit' | t }}
      </button>
    {%- endform -%}

    <p class="auth__note">
      {{ 'customers.register.has_account' | t }}
      <a href="{{ routes.account_login_url }}">{{ 'customers.login.submit' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "t:general.register",
  "tag": "section",
  "settings": [
    { "type": "richtext", "id": "intro", "label": "t:labels.text" },
    {
      "type": "checkbox",
      "id": "show_marketing_optin",
      "label": "t:labels.show_marketing_optin",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
