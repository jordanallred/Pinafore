{% comment %}
  Set a new password, reached from the emailed reset link.
{% endcomment %}

{%- liquid
  assign label_password = 'customers.reset.password' | t
  assign label_confirm = 'customers.reset.confirm' | t
-%}

<div class="reset-band band color-{{ section.settings.color_scheme }} full-width">
  <div class="auth band__inner">
    <header class="auth__header">
      <h1 class="auth__title">{{ 'customers.reset.title' | t }}</h1>
      <p class="auth__note">{{ 'customers.reset.instructions' | t }}</p>
    </header>

    {%- form 'reset_customer_password', class: 'form' -%}
      {%- if form.errors -%}
        <div class="form__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      {% render 'form-field',
        id: 'ResetPassword',
        name: 'customer[password]',
        label: label_password,
        type: 'password',
        autocomplete: 'new-password',
        required: true
      %}

      {% render 'form-field',
        id: 'ResetPasswordConfirm',
        name: 'customer[password_confirmation]',
        label: label_confirm,
        type: 'password',
        autocomplete: 'new-password',
        required: true
      %}

      <button type="submit" class="button button--full">
        {{ 'customers.reset.submit' | t }}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.reset_password",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
