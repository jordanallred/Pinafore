{% comment %}
  The gift card a recipient opens from their email.

  Standalone by design — `{% layout none %}` means no header, no footer, no
  cart. Someone arriving here has been given a present, not sent to shop, and
  the only two things they need are the amount and the code.

  Gifting is a real share of this category's revenue, so the card is built to
  be *used*: the code is set large and in a tabular face so it can be read off
  one screen while typing into another, with a copy button for the common case
  where both are the same phone.
{% endcomment %}

{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}

    {% style %}
      .giftcard {
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-md);
        background-color: var(--color-background);
        color: var(--color-foreground);
      }

      .giftcard__card {
        width: min(28rem, 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-sm);
        padding: var(--space-lg) var(--space-md);
        text-align: center;
        border: var(--border-width) solid var(--color-border-control);
        border-radius: var(--radius-card);
      }

      .giftcard__shop {
        margin: 0;
        font-size: var(--text-sm);
        letter-spacing: var(--tracking-eyebrow);
        text-transform: uppercase;
        color: var(--color-foreground-muted);
      }

      .giftcard__balance {
        margin: 0;
        font-size: var(--text-3xl);
        line-height: 1;
      }

      .giftcard__initial {
        font-size: var(--text-sm);
        color: var(--color-foreground-muted);
      }

      .giftcard__image {
        width: 100%;
        max-width: 260px;
        height: auto;
      }

      /*
       * Monospaced and letter-spaced so the code can be transcribed without
       * second-guessing an O against a 0.
       */
      .giftcard__code {
        width: 100%;
        padding: var(--space-xs);
        font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, monospace;
        font-size: var(--text-lg);
        letter-spacing: 0.12em;
        word-break: break-all;
        background-color: rgb(var(--color-foreground-rgb) / 0.05);
        border-radius: var(--radius-input, 4px);
      }

      .giftcard__note {
        margin: 0;
        font-size: var(--text-sm);
        color: var(--color-foreground-muted);
      }

      .giftcard__expired {
        color: var(--color-sale);
        font-weight: 600;
      }

      .giftcard__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-2xs);
        width: 100%;
      }

      .giftcard__wallet img {
        display: block;
      }

      /* The card is the whole page in print; the buttons are not. */
      @media print {
        .giftcard__actions {
          display: none;
        }

        .giftcard__card {
          border: 0;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body class="color-scheme_1">
    <main class="giftcard">
      <div class="giftcard__card">
        <p class="giftcard__shop">{{ shop.name }}</p>

        {%- if settings.logo != blank -%}
          {%- assign logo_alt = shop.name | escape -%}
          {{
            settings.logo
            | image_url: width: 520
            | image_tag: widths: '260, 400, 520', alt: logo_alt, class: 'giftcard__image'
          }}
        {%- else -%}
          <img
            class="giftcard__image"
            src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.card' | t }}"
            width="300"
            height="200"
          >
        {%- endif -%}

        <p class="giftcard__balance">{{ gift_card.balance | money }}</p>

        {%- comment -%}
          Only worth saying when the two differ — on an untouched card the
          initial value and the balance are the same number twice.
        {%- endcomment -%}
        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign initial_value = gift_card.initial_value | money -%}
          <p class="giftcard__initial">
            {{ 'gift_card.initial_value' | t: value: initial_value }}
          </p>
        {%- endif -%}

        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="giftcard__note giftcard__expired">{{ 'gift_card.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
          <p class="giftcard__note">
            {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
          </p>
        {%- endif -%}

        <p class="giftcard__code" id="GiftCardCode">{{ gift_card.code | format_code }}</p>
        <p class="giftcard__note">{{ 'gift_card.use_at_checkout' | t }}</p>

        <div class="giftcard__actions">
          {%- comment -%}
            Progressive enhancement: the button is added by script, so it never
            appears as a dead control where the clipboard API is unavailable.
            The code is selectable text regardless.
          {%- endcomment -%}
          <a class="button" href="{{ shop.url }}">{{ 'gift_card.shop_now' | t }}</a>

          {%- if gift_card.pass_url -%}
            <a class="giftcard__wallet" href="{{ gift_card.pass_url }}">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                width="200"
                height="60"
              >
            </a>
          {%- endif -%}
        </div>
      </div>
    </main>

    <script>
      (function () {
        if (!navigator.clipboard) return;
        var code = document.getElementById('GiftCardCode');
        var actions = document.querySelector('.giftcard__actions');
        if (!code || !actions) return;

        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'button button--secondary';
        button.textContent = {{ 'gift_card.copy' | t | json }};

        button.addEventListener('click', function () {
          navigator.clipboard.writeText(code.textContent.trim()).then(function () {
            button.textContent = {{ 'gift_card.copied' | t | json }};
          });
        });

        actions.insertBefore(button, actions.firstChild);
      })();
    </script>
  </body>
</html>
