{% doc %}
  Product card. The single most repeated component in the theme, so it stays
  deliberately cheap: no JavaScript for the hover image or the swatches, and
  one image request per card unless the merchant opts into the second.

  Quick add posts straight to /cart/add for single-variant products. Anything
  with options links to the product page instead — guessing a size on the
  customer's behalf is how a boutique earns a return.

  @param {object} product - The product to render
  @param {string} [sizes] - Image sizes attribute for the grid it sits in
  @param {boolean} [lazy] - Lazy-load the image; defaults to true

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 750px) 25vw, 50vw' %}
{% enddoc %}

{% liquid
  assign card_sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif

  assign second_image = product.media[1]
  assign show_second = false
  if settings.card_show_second_image and second_image
    assign show_second = true
  endif

  assign card_alt = product.featured_image.alt | default: product.title | escape

  assign quick_add_ready = false
  if settings.card_show_quick_add and product.available and product.variants.size == 1
    assign quick_add_ready = true
  endif
%}

<article class="card" aria-labelledby="CardTitle-{{ product.id }}">
  <a class="card__media media media--ratio" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{
        product.featured_image
        | image_url: width: 900
        | image_tag:
          widths: '200, 300, 400, 600, 900',
          sizes: card_sizes,
          alt: card_alt,
          loading: loading,
          class: 'card__image'
      }}
      {%- if show_second -%}
        {{
          second_image.preview_image
          | image_url: width: 900
          | image_tag:
            widths: '200, 300, 400, 600, 900',
            sizes: card_sizes,
            alt: '',
            loading: 'lazy',
            class: 'card__image card__image--alt'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__image' }}
    {%- endif -%}

    <div class="card__badges">
      {% render 'product-badges', product: product %}
    </div>
  </a>

  <div class="card__body">
    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <span class="card__vendor">{{ product.vendor }}</span>
    {%- endif -%}

    <h3 class="card__title" id="CardTitle-{{ product.id }}">
      {%- comment -%}
        The whole card is clickable via this link's ::after overlay, which
        keeps one link per card in the accessibility tree instead of three
        pointing at the same place.
      {%- endcomment -%}
      <a class="card__link" href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {% render 'price', product: product, context: 'card', show_from: true %}

    {%- if settings.card_show_swatches -%}
      {%- for option in product.options_with_values -%}
        {%- assign option_key = option.name | downcase -%}
        {%- if option_key == 'color' or option_key == 'colour' -%}
          {%- liquid
            # Without linked swatch metaobjects this row would be identical
            # grey dots, which tells a customer nothing. Fall back to a plain
            # count, which at least says "this comes in four colours".
            assign card_has_swatches = false
            for value in option.values
              if value.swatch.color or value.swatch.image
                assign card_has_swatches = true
                break
              endif
            endfor
          -%}
          {%- if card_has_swatches -%}
            <ul class="card__swatches" role="list" aria-label="{{ option.name }}">
              {%- for value in option.values limit: 5 -%}
                <li
                  class="card__swatch"
                  {% if value.swatch.color %}
                    style="--swatch: {{ value.swatch.color }};"
                  {% elsif value.swatch.image %}
                    style="--swatch-image: url({{ value.swatch.image | image_url: width: 40 }});"
                  {% endif %}
                >
                  <span class="visually-hidden">{{ value }}</span>
                </li>
              {%- endfor -%}
              {%- if option.values.size > 5 -%}
                <li class="card__swatch-more">+{{ option.values.size | minus: 5 }}</li>
              {%- endif -%}
            </ul>
          {%- elsif option.values.size > 1 -%}
            <span class="card__option-count">
              {{ 'products.color_count' | t: count: option.values.size }}
            </span>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if quick_add_ready -%}
      <form action="{{ routes.cart_add_url }}" method="post" class="card__quick-add" data-quick-add>
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          class="button button--secondary card__quick-add-button"
          type="submit"
          aria-label="{{ 'products.quick_add_title' | t: title: product.title }}"
        >
          {{ 'products.quick_add' | t }}
        </button>
      </form>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .card__media {
    display: block;
    position: relative;
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__image--alt {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  /*
   * Hover swap and zoom are gated on a real pointer. On touch there is no
   * hover, and running these would just cost a decode for an image nobody
   * asked to see.
   */
  @media (hover: hover) {
    .card:hover .card__image--alt {
      opacity: 1;
    }

    .card:hover .card__image:only-child {
      transform: scale(1.03);
    }

    .card__image:only-child {
      transition: transform var(--duration-slow) var(--ease-out);
    }
  }

  .card__badges {
    position: absolute;
    top: var(--space-2xs);
    left: var(--space-2xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    align-items: flex-start;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .card__vendor {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .card__title {
    font-size: var(--text-base);
    font-weight: var(--font-heading--weight);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .card__link {
    text-decoration: none;
  }

  /* Stretches the title link over the whole card. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .card__swatches {
    list-style: none;
    margin: 0.15rem 0 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .card__swatch {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: var(--radius-full);
    background-color: var(--swatch, var(--color-border));
    background-image: var(--swatch-image, none);
    background-size: cover;
    border: var(--border-width) solid rgb(var(--color-foreground-rgb) / 0.15);
  }

  .card__option-count {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .card__swatch-more {
    font-size: var(--text-2xs);
    color: var(--color-foreground-muted);
  }

  .card__quick-add {
    margin-top: var(--space-3xs);
  }

  .card__quick-add-button {
    /* Above the card's stretched link, or it would never receive the click. */
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: var(--control-height-sm);
    font-size: var(--text-xs);
  }

  @media (hover: hover) {
    .card__quick-add {
      opacity: 0;
      transition: opacity var(--duration-fast) var(--ease-out);
    }

    .card:hover .card__quick-add,
    .card:focus-within .card__quick-add {
      opacity: 1;
    }
  }
{% endstylesheet %}
