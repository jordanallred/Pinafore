{% doc %}
  Article card for blog listings.

  @param {object} article - The article
  @param {boolean} [lazy] - Lazy-load the image; defaults to true

  @example
  {% render 'article-card', article: article %}
{% enddoc %}

{% liquid
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign article_alt = article.image.alt | default: article.title | escape
%}

<article class="article-card" aria-labelledby="ArticleTitle-{{ article.id }}">
  {%- if article.image -%}
    <a class="article-card__media media media--ratio" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
      {{
        article.image
        | image_url: width: 900
        | image_tag:
          widths: '300, 500, 700, 900',
          sizes: '(min-width: 750px) 33vw, 100vw',
          alt: article_alt,
          loading: loading,
          class: 'article-card__image'
      }}
    </a>
  {%- endif -%}

  <div class="article-card__body">
    <time class="article-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
      {{ article.published_at | date: format: 'abbreviated_date' }}
    </time>
    <h2 class="article-card__title" id="ArticleTitle-{{ article.id }}">
      <a class="article-card__link" href="{{ article.url }}">{{ article.title }}</a>
    </h2>
    <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
  </div>
</article>

{% stylesheet %}
  .article-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .article-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .article-card__date {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .article-card__title {
    font-size: var(--text-lg);
    margin: 0;
  }

  .article-card__link {
    text-decoration: none;
  }

  .article-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .article-card__excerpt {
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}
