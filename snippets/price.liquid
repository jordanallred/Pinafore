{% doc %}
  Renders a price, handling sale, ranges, and unit pricing consistently
  everywhere a price appears.

  The compare-at price is marked up with <s> rather than styled with
  text-decoration alone, so a screen reader announces it as struck-through
  and the "was / now" relationship survives without color.

  @param {object} product - Product or line item to price
  @param {string} [context] - 'card' | 'product' | 'line'. Controls size only.
  @param {boolean} [show_from] - Prefix ranged prices with "From"

  @example
  {% render 'price', product: product, context: 'card', show_from: true %}
{% enddoc %}

{% liquid
  assign target = product
  assign price = target.price | default: 0
  assign compare_at = target.compare_at_price

  if target.price_varies and show_from
    assign price = target.price_min
  endif

  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif
%}

<div class="price price--{{ context | default: 'card' }}{% if on_sale %} price--on-sale{% endif %}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
    <s class="price__was">{{ compare_at | money }}</s>
    <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
    <span class="price__now">{{ price | money }}</span>
  {%- else -%}
    {%- if target.price_varies and show_from -%}
      <span class="price__from">{{ 'products.price.from' | t }}</span>
    {%- endif -%}
    <span class="price__current">{{ price | money }}</span>
  {%- endif -%}

  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      {{ target.unit_price | money }}/{% if target.unit_price_measurement.reference_value != 1 %}
        {{- target.unit_price_measurement.reference_value -}}
      {% endif %}{{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>

{% stylesheet %}
  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
  }

  .price--product {
    font-size: var(--text-md);
  }

  .price__was {
    color: var(--color-foreground-muted);
    font-size: 0.9em;
  }

  .price__now {
    color: var(--color-sale);
    font-weight: 700;
  }

  .price__from {
    color: var(--color-foreground-muted);
    font-size: 0.9em;
  }

  .price__unit {
    flex-basis: 100%;
    color: var(--color-foreground-muted);
    font-size: var(--text-2xs);
  }
{% endstylesheet %}
